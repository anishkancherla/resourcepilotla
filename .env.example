# Run `make bootstrap`; never put real seeds in this tracked template.
POSTGRES_DB=resourcepilot
POSTGRES_USER=resourcepilot
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://resourcepilot:local_only_change_me@postgres:5432/resourcepilot

# One stable private seed, port, and address per real uAgent: eight platform agents,
# then five independent demo seller agents. Seller wallets are public fetch1 addresses
# derived from each seller's seed and are used only for stable-testnet payouts.
ORCHESTRATOR_SEED=
ORCHESTRATOR_ADDRESS=
ORCHESTRATOR_PORT=8000
INTAKE_SEED=
INTAKE_ADDRESS=
INTAKE_PORT=8001
DISCOVERY_SEED=
DISCOVERY_ADDRESS=
DISCOVERY_PORT=8002
VERIFICATION_SEED=
VERIFICATION_ADDRESS=
VERIFICATION_PORT=8003
ANALYSIS_SEED=
ANALYSIS_ADDRESS=
ANALYSIS_PORT=8004
PLANNER_SEED=
PLANNER_ADDRESS=
PLANNER_PORT=8005
FULFILLMENT_SEED=
FULFILLMENT_ADDRESS=
FULFILLMENT_PORT=8006
MEMORY_AUDIT_SEED=
MEMORY_AUDIT_ADDRESS=
MEMORY_AUDIT_PORT=8007
WESTWOOD_PRINT_SEED=
WESTWOOD_PRINT_ADDRESS=
WESTWOOD_PRINT_PORT=8100
WESTWOOD_PRINT_WALLET=
GAYLEY_COPY_SEED=
GAYLEY_COPY_ADDRESS=
GAYLEY_COPY_PORT=8101
GAYLEY_COPY_WALLET=
FLASH_PRINTS_SEED=
FLASH_PRINTS_ADDRESS=
FLASH_PRINTS_PORT=8102
FLASH_PRINTS_WALLET=
GEAR_SHARE_SEED=
GEAR_SHARE_ADDRESS=
GEAR_SHARE_PORT=8103
GEAR_SHARE_WALLET=
STUDIO_ROOMS_SEED=
STUDIO_ROOMS_ADDRESS=
STUDIO_ROOMS_PORT=8104
STUDIO_ROOMS_WALLET=

AGENTVERSE_URL=https://agentverse.ai
ENABLE_MAILBOX=true

# Timeouts. Discovery waits QUOTE_WINDOW_SECONDS for seller quotes; Fulfillment waits
# HOLD_WINDOW_SECONDS for every seller to confirm a hold or a booking.
TASK_TIMEOUT_SECONDS=45
QUOTE_WINDOW_SECONDS=12
HOLD_WINDOW_SECONDS=15
HOLD_TTL_SECONDS=600

# Optional open discovery: also query the Almanac for agents that publish the
# ResourceHold seller protocol. Unlisted sellers are still rejected by Verification.
ALMANAC_DISCOVERY=false

# Demo controls let a seller's own profile chat toggle a simulated outage.
# Keep false outside a recorded demo. A seller can also start faulty, for example:
# WESTWOOD_PRINT_FAULT_MODE=ghost_holds
SELLER_DEMO_CONTROLS=false

# Escrow checkout. The buyer pays the Orchestrator; sellers are paid out only after
# every booking commits. Booking fee = PLATFORM_FEE_BPS of the subtotal + fixed cents.
PLATFORM_FEE_BPS=300
PLATFORM_FEE_FIXED_CENTS=30
PAYMENT_DEADLINE_SECONDS=600

# Mock Stripe: no Stripe API call and no funds moved.
STRIPE_MOCK_RECIPIENT=acct_mock_resourcepilot

# FET: faucet-issued Fetch stable-testnet tokens only. FET_PER_USD is a fixed demo test
# rate, not a market price. FET_MAX_AMOUNT caps every test payment.
FET_NETWORK=stable-testnet
FET_DENOM=atestfet
FET_PER_USD=0.0001
FET_MAX_AMOUNT=0.01
# Send real stable-testnet payout/refund transfers from the Orchestrator wallet.
# When false, payouts are recorded in the escrow ledger as scheduled, not sent.
FET_PAYOUTS_ENABLED=false
# Filled from the Orchestrator wallet at runtime. Override only if needed.
FET_RECIPIENT_WALLET=
