# Run `make bootstrap`; never put real seeds in this tracked template.
POSTGRES_DB=resourcepilot
POSTGRES_USER=resourcepilot
POSTGRES_PASSWORD=local_only_change_me
DATABASE_URL=postgresql://resourcepilot:local_only_change_me@postgres:5432/resourcepilot

# One stable private seed, port, and address per real uAgent: eight agents, each its own
# process run by agents/run.py. Agentverse Basic allows eight Mailbox agents.
ORCHESTRATOR_SEED=
ORCHESTRATOR_ADDRESS=
ORCHESTRATOR_PORT=8000
INTAKE_SEED=
INTAKE_ADDRESS=
INTAKE_PORT=8001
RESEARCHER_SEED=
RESEARCHER_ADDRESS=
RESEARCHER_PORT=8002
CAMPUS_ROOMS_SEED=
CAMPUS_ROOMS_ADDRESS=
CAMPUS_ROOMS_PORT=8003
VERIFICATION_SEED=
VERIFICATION_ADDRESS=
VERIFICATION_PORT=8004
PLANNER_SEED=
PLANNER_ADDRESS=
PLANNER_PORT=8005
MEMORY_AUDIT_SEED=
MEMORY_AUDIT_ADDRESS=
MEMORY_AUDIT_PORT=8006
EMERGENCY_SEED=
EMERGENCY_ADDRESS=
EMERGENCY_PORT=8007

AGENTVERSE_URL=https://agentverse.ai
ENABLE_MAILBOX=true

# Live public sources, all keyless: IPEDS (Urban Institute Education Data API), school
# websites, and public LibCal pages. Each request is bounded by this timeout (1-20 seconds).
API_TIMEOUT_SECONDS=8

# Emergency (demo): the Emergency Dispatcher asks an ElevenLabs voice agent to phone ONE demo
# contact (a teammate playing the dispatcher). It never calls 911 or any emergency or crisis
# number, and refuses to start if EMERGENCY_DEMO_TO_NUMBER is one. ElevenLabs and Twilio bill
# each call to your accounts. Setup: agents/emergency/README.md. Leave empty to turn it off.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
EMERGENCY_DEMO_TO_NUMBER=
# Optional regional host, e.g. https://api.us.elevenlabs.io
ELEVENLABS_API_BASE=

# Each specialist step must answer within this many seconds (at least 10).
TASK_TIMEOUT_SECONDS=45
